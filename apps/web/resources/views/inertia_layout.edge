<!DOCTYPE html>
<html>

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/svg+xml" href="{{ asset('resources/images/favicon.svg') }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('resources/images/favicon-32x32.png') }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('resources/images/favicon-16x16.png') }}">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">

    <!-- SEO -->
    <meta name="description" content="DataRural — Plataforma de Datasets e Repositório de Dados de Pesquisa da Universidade Federal Rural do Rio de Janeiro (UFRRJ)." />
    <meta name="keywords" content="DataRural, UFRRJ, Datasets, Dados Abertos, Pesquisa, Agronomia, Clima, Meteorologia, Universidade Federal Rural do Rio de Janeiro" />
    <meta name="author" content="UFRRJ" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="DataRural — Plataforma de Datasets da UFRRJ" />
    <meta property="og:description" content="Plataforma institucional de datasets e repositório de dados de pesquisa da UFRRJ." />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="DataRural — Plataforma de Datasets da UFRRJ" />
    <meta name="twitter:description" content="Plataforma institucional de datasets e repositório de dados de pesquisa da UFRRJ." />

    <title inertia>
      DataRural — UFRRJ
    </title>

    <script>
      (function() {
        try {
          var t = localStorage.getItem('dr-theme');
          if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    @stack('dumper')
    @viteReactRefresh()
    @inertiaHead()
    @vite([
    'resources/js/app.js',
    'app/core/ui/app/app.tsx'
    ])
  </head>

  <body class="min-h-screen w-screen font-sans">
    @inertia()
  </body>

</html>
